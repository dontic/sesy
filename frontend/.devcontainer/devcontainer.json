// devcontainer.json
{
  "name": "Sesy Frontend", // Name of the development container
  "shutdownAction": "stopContainer", // Container behavior on VSCode close: none, stopContainer (default for image or Dockerfile), and stopCompose (default for Docker Compose)
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // Mount the repo root (contains .git) and open the frontend folder
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces/sesy,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/sesy/frontend",
  // "appPort": ["5173:5173"], // Port forwarding
  // Extensions and settings
  "customizations": {
    "vscode": {
      "extensions": [
        // Comment or uncomment the extensions you want to use
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "stackbreak.comment-divider",
        "stuart.unique-window-colors"
      ],
      "settings": {
        // Prettier settings
        "prettier.enable": true,
        "editor.formatOnSave": true, // Format files on save
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[typescript]": {
          // TypeScript settings
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          // TypeScript React settings
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          // JSON settings
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.quickSuggestions": {
            "strings": true
          },
          "editor.suggest.insertMode": "replace"
        },
        "prettier.semi": true,
        "prettier.trailingComma": "none",
        "prettier.singleQuote": false,
        "prettier.printWidth": 80,
        // Window colors
        "workbench.colorCustomizations": {
          "activityBar.background": "#298dff",
          "titleBar.activeBackground": "#298dff",
          "titleBar.activeForeground": "#FBFBF6"
        },
        // Prevent json schema warnings
        "json.schemas": [
          {
            "fileMatch": ["/package.json"],
            "url": "https://json.schemastore.org/package",
            "schema": true
          }
        ]
      }
    }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Allow npm global packages to be written by the user
  "postCreateCommand": "sudo chmod -R g+w /usr/local/share/npm-global",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,consistency=cached", // SSH keys for GitHub
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  // Set the remote user to node instead of root
  "remoteUser": "node",
  "containerUser": "node"
}