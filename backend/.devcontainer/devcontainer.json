// devcontainer.json
{
    "name": "Sesy Backend", // Name of the development container
    "shutdownAction": "stopCompose", // Container behavior on VSCode close: none, stopContainer (default for image or Dockerfile), and stopCompose (default for Docker Compose)
    "dockerComposeFile": "docker-compose.yml",
    "service": "django",
    "workspaceFolder": "/workspaces/sesy/backend",
    // Extensions and settings
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "mhutchie.git-graph",
                "ms-python.black-formatter",
                "stuart.unique-window-colors",
                "stackbreak.comment-divider"
            ],
            "settings": {
                // Black formatter settings
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "ms-python.black-formatter",
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                },
                // Window colors settings
                "workbench.colorCustomizations": {
                    "activityBar.background": "#0C4B33",
                    "titleBar.activeBackground": "#0C4B33",
                    "titleBar.activeForeground": "#FBFBF6"
                },
                // Prevent json schema warnings
                "json.schemas": [
                    {
                        "fileMatch": [
                            "/package.json"
                        ],
                        "url": "https://json.schemastore.org/package",
                        "schema": true
                    }
                ]
            }
        }
    },
    // Allow npm global packages to be written by the user
    "postCreateCommand": "sudo chmod -R g+w /usr/local/share/npm-global",
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
    },
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached", // SSH keys for GitHub
        "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },
    "remoteUser": "vscode",
    "containerUser": "vscode",
    "updateRemoteUserUID": true
}