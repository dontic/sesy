# Sesy deployment .env template
#
# Copy this file to .env and fill in the values for your environment:
#   cp .env.template .env

# ----------------------------------- App ------------------------------------ #
# Secret key used to secure the app. REQUIRED.
# Generate one with: openssl rand -base64 48
DJANGO_SECRET_KEY=change-me

# The domain Sesy will be served under.
DOMAIN=sesy.mydomain.com

# Host port Sesy is published on.
HTTP_PORT=8080

# --------------------------------- Database --------------------------------- #
# Used both to initialise the bundled postgres service and by Django to connect.
# Change POSTGRES_PASSWORD before the first start: postgres only applies these
# values when its data volume is created.
POSTGRES_DB_NAME=django
POSTGRES_USER=django
POSTGRES_PASSWORD=change-me

# Uncomment and override when connecting to an external PostgreSQL server.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# ---------------------------------- Redis ----------------------------------- #
# Uncomment and override when connecting to an external Redis server.
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
